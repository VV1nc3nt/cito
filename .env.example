# Copy to .env and replace every placeholder. Never commit .env.

# PostgreSQL credentials used by the postgres container.
POSTGRES_USER=cito
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cito
# Host port for the database (change if 5432 is taken; update DATABASE_URL too).
# POSTGRES_PORT=5432

# Connection string for `pnpm dev` on the host. Inside Docker Compose the app
# service overrides the host part to `postgres`.
DATABASE_URL=postgres://cito:change-me@127.0.0.1:5432/cito

# Long random string, e.g. `openssl rand -hex 32`.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public origin of the site, no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Host port of the app container (bound to 127.0.0.1, put nginx in front of it).
# APP_PORT=3000

# Directory for uploaded media. Defaults to ./media locally and /app/media in Docker.
# MEDIA_DIR=
